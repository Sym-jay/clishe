# Maintainer: Sym-jay <https://github.com/Sym-jay>
pkgname=clishe
pkgver=0.6.0
pkgrel=1
pkgdesc="Plain English to shell commands for Linux beginners: offline, learn as you go, optional local AI"
arch=('any')
url="https://github.com/Sym-jay/clishe"
license=('MIT')
depends=('bash' 'python')
optdepends=('ollama: local AI for phrases Clishe does not know yet'
            'man-db: explain any installed command from its manual'
            'glib2: move deleted files to the Trash instead of erasing them')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a7f3589f8070464ac539451c595770e7fc78e9ad518ab97ae41a9dc9712d02fb')

package() {
  cd "$pkgname-$pkgver"
  local dest="$pkgdir/usr/share/$pkgname"
  install -d "$dest/providers" "$pkgdir/usr/bin"
  install -m755 clishe.sh "$dest/"
  install -m644 clishe-bind.* ./*.py ./*.json "$dest/"
  install -d "$dest/lessons"
  install -m644 lessons/*.json "$dest/lessons/"
  install -m644 providers/*.py "$dest/providers/"
  # clishe.sh follows this link back to /usr/share/clishe to find its files.
  ln -s "/usr/share/$pkgname/clishe.sh" "$pkgdir/usr/bin/clishe"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
