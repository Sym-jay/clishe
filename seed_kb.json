{
  "show me disk usage": "df -h",
  "how much space do i have": "df -h",
  "list files": "ls -la",
  "show hidden files": "ls -la",
  "what's my ip": "curl ifconfig.me",
  "check my ip address": "hostname -I",
  "how much memory is free": "free -h",
  "show running processes": "ps aux",
  "kill a process": "kill -9",
  "search for a file": "find . -name",
  "search inside files": "grep -r",
  "show current directory": "pwd",
  "make a new folder": "mkdir",
  "delete a folder": "rm -rf",
  "copy a file": "cp",
  "move a file": "mv",
  "show file contents": "cat",
  "show first lines of a file": "head",
  "show last lines of a file": "tail",
  "check disk speed": "hdparm -Tt /dev/sda",
  "what's using my cpu": "top",
  "show network connections": "ss -tuln",
  "compress a folder": "tar -czvf",
  "extract a tar file": "tar -xzvf",
  "check my linux version": "cat /etc/os-release",
  "how long has this been running": "uptime",
  "show logged in users": "who",
  "change file permissions": "chmod",
  "change file owner": "chown",
  "download a file": "wget",
  "check internet connection": "ping -c 4 google.com"
}
