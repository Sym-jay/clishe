{
  "show me disk usage": "df -h",
  "how much space do i have": "df -h",
  "what's taking up space": "du -sh * | sort -h",
  "show folder sizes": "du -sh * | sort -h",
  "list files": "ls -la",
  "show hidden files": "ls -la",
  "what's my ip": "curl -s ifconfig.me",
  "check my ip address": "hostname -I",
  "how much memory is free": "free -h",
  "show running processes": "ps aux",
  "find a process by name": "pgrep -a <program name>",
  "kill a process": "kill <process id>",
  "stop a program by name": "pkill <program name>",
  "search for a file": "find . -iname <file name>",
  "find big files": "find . -type f -size +100M",
  "search inside files": "grep -rn <text> .",
  "show current directory": "pwd",
  "where am i": "pwd",
  "go to my home folder": "cd ~",
  "go up a folder": "cd ..",
  "go to a folder": "cd <folder>",
  "make a new folder": "mkdir -p <folder name>",
  "create an empty file": "touch <file name>",
  "delete a file": "rm <file>",
  "delete a folder": "rm -r <folder>",
  "copy a file": "cp <file> <destination>",
  "copy a folder": "cp -r <folder> <destination>",
  "move a file": "mv <file> <destination>",
  "rename a file": "mv <old name> <new name>",
  "show file contents": "cat <file>",
  "read a long file": "less <file>",
  "show first lines of a file": "head -n 20 <file>",
  "show last lines of a file": "tail -n 20 <file>",
  "watch a log file": "tail -f <file>",
  "count lines in a file": "wc -l <file>",
  "compare two files": "diff <first file> <second file>",
  "check disk speed": "sudo hdparm -Tt <disk>",
  "what's using my cpu": "top",
  "show network connections": "ss -tuln",
  "compress a folder": "tar -czvf <archive name>.tar.gz <folder>",
  "extract a tar file": "tar -xzvf <archive>",
  "check my linux version": "cat /etc/os-release",
  "show system info": "uname -a",
  "how long has this been running": "uptime",
  "show logged in users": "who",
  "who am i": "whoami",
  "show date and time": "date",
  "clear the screen": "clear",
  "make a script executable": "chmod +x <file>",
  "change file permissions": "chmod <mode> <file>",
  "change file owner": "sudo chown <user> <file>",
  "download a file": "wget <url>",
  "check internet connection": "ping -c 4 google.com",
  "where is a program installed": "command -v <program name>",
  "show my path": "echo $PATH"
}
